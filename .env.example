
# =====================================================
# CROKETE STORE (Next.js) — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
#
# IMPORTANTE: Las keys de Stripe (public/secret) vienen del
# backend API, NO se configuran aqui. Esto garantiza que
# frontend y backend siempre usen la misma cuenta Stripe.
# =====================================================

# ===== API (REQUERIDO) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:5055/v1
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:5055

# ===== CLOUDINARY =====
NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<your_cloud_name>/image/upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your_upload_preset>

# ===== STORE DOMAIN =====
NEXT_PUBLIC_STORE_DOMAIN=http://localhost:3000/

# ===== NEXTAUTH =====
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl rand -base64 32>"